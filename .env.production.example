# ShopMate AaaS - Production Environment Configuration
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Networking & URLs
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://app.shopmate.ai

# Database (PostgreSQL Production Cluster with PgBouncer / Managed RDS)
DATABASE_URL=postgresql+asyncpg://prod_user:PROD_STRONG_DB_PASSWORD@prod-db-primary.internal:5432/shopmate_prod
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50

# Cache, Rate Limiting & Revocation (Redis Cluster)
REDIS_URL=rediss://prod-redis-cluster.internal:6379/0

# Security Keys (Minimum 32-character high entropy keys from HSM / Vault)
JWT_SECRET=REPLACE_WITH_STRONG_PRODUCTION_JWT_SECRET_32_CHARS
ENCRYPTION_KEY=REPLACE_WITH_STRONG_PRODUCTION_ENCRYPTION_KEY_32_BYTES

# Payment Gateway (Razorpay Live Keys)
RAZORPAY_KEY_ID=rzp_live_placeholder_key
RAZORPAY_KEY_SECRET=rzp_live_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_live_webhook_secret

# AI Providers
SARVAM_API_KEY=PLACEHOLDER_PRODUCTION_SARVAM_API_KEY
OPENAI_API_KEY=PLACEHOLDER_PRODUCTION_OPENAI_API_KEY
ANTHROPIC_API_KEY=PLACEHOLDER_PRODUCTION_ANTHROPIC_API_KEY
