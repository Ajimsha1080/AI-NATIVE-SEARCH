# ShopMate AaaS - Staging Environment Configuration
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Networking & URLs
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://staging.shopmate.ai

# Database (PostgreSQL Staging Instance)
DATABASE_URL=postgresql+asyncpg://staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/shopmate_staging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Rate Limiting
REDIS_URL=redis://staging-redis.internal:6379/0

# Security Keys (Minimum 32-character high entropy keys)
JWT_SECRET=REPLACE_WITH_STRONG_STAGING_JWT_SECRET_32_CHARS
ENCRYPTION_KEY=REPLACE_WITH_STRONG_STAGING_ENCRYPTION_KEY_32_BYTES

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# AI Providers
SARVAM_API_KEY=PLACEHOLDER_STAGING_SARVAM_API_KEY
OPENAI_API_KEY=PLACEHOLDER_STAGING_OPENAI_API_KEY
