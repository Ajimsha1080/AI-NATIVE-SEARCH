# ==============================================================================
# AAAS E-COMMERCE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# WARNING: All secrets below are placeholders and WILL FAIL boot validation.
# Generate strong production secrets using: bash scripts/gen-secrets.sh
# ==============================================================================

# Application Environment Mode ('production' | 'development')
APP_ENV=production
NODE_ENV=production

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_DB=aaas_enterprise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_STRONG_POSTGRES_PASSWORD>
DATABASE_URL=postgresql://postgres:<GENERATE_STRONG_POSTGRES_PASSWORD>@localhost:5432/aaas_enterprise

# Redis Distributed Cache & Rate Limiter
REDIS_URL=redis://localhost:6379/0

# JWT Secrets (Minimum 32 bytes cryptographically secure strings)
# DO NOT reuse secrets across Session and Service channels
SESSION_JWT_SECRET=<GENERATE_32_CHAR_SECRET_WITH_GEN_SECRETS_SH>
SERVICE_JWT_SECRET=<GENERATE_32_CHAR_SECRET_WITH_GEN_SECRETS_SH>
INTERNAL_SERVICE_SECRET=<GENERATE_32_CHAR_SECRET_WITH_GEN_SECRETS_SH>

# Backend Service URLs
PYTHON_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Enterprise Billing (Optional - If unset, billing operations return 503)
STRIPE_SECRET_KEY=sk_live_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_PRO=price_pro_PLACEHOLDER
STRIPE_PRICE_GROWTH=price_growth_PLACEHOLDER
STRIPE_PRICE_ENTERPRISE=price_enterprise_PLACEHOLDER

# LLM Providers (Sarvam AI / Anthropic / OpenAI / Ollama)
LLM_PROVIDER=sarvam
SARVAM_API_KEY=REDACTED_SECRET
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER
OPENAI_API_KEY=sk-proj-PLACEHOLDER
LLM_MODEL=sarvam-105b-conversations

# Email & Verification (Resend / AWS SES)
RESEND_API_KEY=re_PLACEHOLDER
EMAIL_FROM="ShopMate AI <support@aaas-platform.com>"

# Cloudflare Turnstile / hCaptcha (Anti-Abuse)
TURNSTILE_SECRET_KEY=0x4AAAAAAAPLACEHOLDER
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAPLACEHOLDER_SITE

# Sentry Monitoring & Observability
SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
